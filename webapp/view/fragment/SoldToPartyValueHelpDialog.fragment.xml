<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <TableSelectDialog
        id="idSoldToPartyValueHelpDialog"
        title="Select Sold-to Party"
        noDataText="No customers found."
        search="onSoldToPartyValueHelpSearch"
        confirm="onSoldToPartyValueHelpConfirm"
        cancel="onSoldToPartyValueHelpCancel"
        contentWidth="540px"
        items="{reportModel>/results}">
        <columns>
            <Column width="160px">
                <header>
                    <Label text="Customer ID" design="Bold" />
                </header>
            </Column>
            <Column>
                <header>
                    <Label text="Customer Name" design="Bold" />
                </header>
            </Column>
        </columns>
        <items>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{reportModel>soldToParty}" />
                    <Text text="{reportModel>salesOrg}" />
                </cells>
            </ColumnListItem>
        </items>
    </TableSelectDialog>
</core:FragmentDefinition>
