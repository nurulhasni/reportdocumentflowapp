<core:FragmentDefinition id="TrackStatusSalesDocumentCellsFragment"
	xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout" xmlns="sap.m">
	<!-- 1 SalesDocument -->
	<ObjectIdentifier
		id="TSSDCellsObjectIdentifierSalesDocument"
		title="{SalesDocument}" 
		titleActive="true"
		titlePress="onLinkSalesDocumentPressed"></ObjectIdentifier>
	<!---->
	<!-- 
       Status                               
       0 Not relevant                     no icon, no color, visible
       1 Not yet processed (Open)         future icon, color default, visible 
       2 Partially processed (In Process) process icon, color default, visible
       3 Completed						  accept icon, color positive, visible 
       4 Overdue issue                    warning2 icon, color negative , visible 
       5 Due next issue					  warning2 icon, color critical, visible 
       -->
	<!-- 2 OverallFulfillmentStatus -->
	<layout:VerticalLayout id="TSSDCellsVerticalLayoutOverallFulfillmentStatus">
		<core:Icon 
			id="TSSDCellsIcon_OverallFulfillmentStatus_1"
			visible="{= ${OverallFulfillmentStatus} === '1' }" 
			src="sap-icon://future" color="Default" 
			tooltip="{to_OverallFulfillmentStatus/FulfillmentStatus_Text}"></core:Icon>
		<core:Icon 
			id="TSSDCellsIcon_OverallFulfillmentStatus_2"
			visible="{= ${OverallFulfillmentStatus} === '2' }" 
			src="sap-icon://process" color="Default" 
			tooltip="{to_OverallFulfillmentStatus/FulfillmentStatus_Text}"></core:Icon>
		<core:Icon 
			id="TSSDCellsIcon_OverallFulfillmentStatus_3"
			visible="{= ${OverallFulfillmentStatus} === '3' }" 
			src="sap-icon://message-success" color="Positive"
			tooltip="{to_OverallFulfillmentStatus/FulfillmentStatus_Text}"></core:Icon>
		<core:Icon 
			id="TSSDCellsIcon_OverallFulfillmentStatus_4"
			visible="{= ${OverallFulfillmentStatus} === '4' }" 
			src="sap-icon://message-error" 
			color="Negative"
			tooltip="{to_OverallFulfillmentStatus/FulfillmentStatus_Text}"></core:Icon>
		<core:Icon 
			id="TSSDCellsIcon_OverallFulfillmentStatus_5"
			visible="{= ${OverallFulfillmentStatus} === '5' }" 
			src="sap-icon://message-warning" 
			color="Critical"
			tooltip="{to_OverallFulfillmentStatus/FulfillmentStatus_Text}"></core:Icon>
	</layout:VerticalLayout>
